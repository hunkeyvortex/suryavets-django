# Environment-variable reference. Settings read process environment; .env is not auto-loaded.
# Configure these in your launch environment. Never commit a populated .env.
# Local development defaults to SQLite. Render requires every production value below.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-production
DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
CSRF_TRUSTED_ORIGINS=
# Set True only when HTTPS is terminated by your hosting platform.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Leave off during development; configure and verify a production mail backend first.
ORDER_EMAIL_ENABLED=False
DEFAULT_FROM_EMAIL=Surya Vets <noreply@localhost>
# Optional purchase-flow configuration. Supply values locally, never in Git.
ORDER_EMAIL_AUTO_SEND=
ORDER_NOTIFICATION_EMAIL=
PUBLIC_SITE_URL=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
RAZORPAY_ENABLED=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional Brevo transactional API backend (see BREVO_EMAIL_SETUP.md).
BREVO_API_KEY=
BREVO_SANDBOX=
BREVO_TIMEOUT=
DEFAULT_FROM_NAME=
