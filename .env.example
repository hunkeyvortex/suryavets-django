# Copy this file to .env for local configuration. Do not commit .env.
# Local development defaults to SQLite. Render requires every production value below.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-production
DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
CSRF_TRUSTED_ORIGINS=
# Set True only when HTTPS is terminated by your hosting platform.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Leave off during development; configure and verify a production mail backend first.
ORDER_EMAIL_ENABLED=False
DEFAULT_FROM_EMAIL=Surya Vets <noreply@localhost>
